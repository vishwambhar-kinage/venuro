# ─── Server Configuration ─────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET=venuro_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRE=7d

# ─── Admin Seed Credentials ───────────────────────────────────
ADMIN_EMAIL=admin@venuro.com
ADMIN_PASSWORD=password123

# ─── Optional: MongoDB Atlas Cluster (Free tier: mongodb.com) ─
# If left blank, Venuro automatically runs on high-speed in-memory engine
MONGODB_URI=

# ─── Optional: Upstash Redis (Free tier: upstash.com) ─────────
# If left blank, Venuro automatically uses embedded in-memory Redis engine
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Google Gemini AI (Free tier: aistudio.google.com) ────────
# Paste your Gemini API key below to power AI Chat Concierge
GEMINI_API_KEY=

# ─── Optional: Razorpay Payment Gateway (razorpay.com) ────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Optional: Gmail SMTP for Real OTP Emails ──────────────────
EMAIL_FROM=
EMAIL_APP_PASSWORD=

# ─── Cryptographic QR Pass Signature Secret ───────────────────
QR_HMAC_SECRET=venuro_qr_cryptographic_hmac_secret_key_2026
