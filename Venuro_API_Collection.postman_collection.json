{
  "info": {
    "_postman_id": "venuro-flagship-api-v2",
    "name": "Venuro 🎟️ — Flagship API Collection",
    "description": "Complete production API test collection for Venuro: AI-Powered Entertainment Discovery & High-Concurrency Reservation Platform.\n\nTech Stack: React, Node.js, Express, MongoDB, Redis Concurrency Locking, JWT RBAC, Google Gemini 1.5 Flash RAG, HMAC-SHA256 QR passes, Razorpay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Login - Normal User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('User role is user', function () { pm.expect(jsonData.user.role).to.eql('user'); });",
                  "if (jsonData.token) { pm.environment.set('userToken', jsonData.token); pm.environment.set('authToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@venuro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login - Platform Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Admin role is admin', function () { pm.expect(jsonData.user.role).to.eql('admin'); });",
                  "if (jsonData.token) { pm.environment.set('adminToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@venuro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login - Event Coordinator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Coordinator role is coordinator', function () { pm.expect(jsonData.user.role).to.eql('coordinator'); });",
                  "if (jsonData.token) { pm.environment.set('coordToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coordinator@venuro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Authenticated User (Profile)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Register User (Generates 6-Digit OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Interview Demo Candidate\",\n  \"email\": \"candidate@venuro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "2. Event Catalog & Discovery",
      "item": [
        {
          "name": "Get All Events (Catalog)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Filter Events by Category (Concerts)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/events?category=concerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [{ "key": "category", "value": "concerts" }]
            }
          }
        },
        {
          "name": "Search Events (Keyword Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/events?search=coldplay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [{ "key": "search", "value": "coldplay" }]
            }
          }
        },
        {
          "name": "Get Event Details & Shows by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events/evt_dune2", "host": ["{{baseUrl}}"], "path": ["api", "events", "evt_dune2"] }
          }
        },
        {
          "name": "Get Interactive Seat Map by Show ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/shows/shw_dune2_1/seat-map", "host": ["{{baseUrl}}"], "path": ["api", "shows", "shw_dune2_1", "seat-map"] }
          }
        }
      ]
    },
    {
      "name": "3. Concurrency Control & Seat Locking (Redis)",
      "item": [
        {
          "name": "Acquire Atomic Seat Locks (SET NX EX 300)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 409', function () { pm.expect([200, 409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"shw_dune2_1\",\n  \"seatIds\": [\"C5\", \"C6\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/lock-seats", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "lock-seats"] }
          }
        },
        {
          "name": "Release Seat Locks Manually",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"shw_dune2_1\",\n  \"seatIds\": [\"C5\", \"C6\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/release-seats", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "release-seats"] }
          }
        }
      ]
    },
